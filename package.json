{
  "name": "optimizely-saas-starter",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "yarn@4.13.0",
  "scripts": {
    "dev": "npx -y concurrently 'next dev --experimental-https --turbo' 'graphql-codegen -w' --kill-others --names frontend,graphql",
    "dev:next": "next dev --experimental-https --turbo",
    "build:dev": "next build",
    "build": "graphql-codegen && next build && npx -y @remkoj/optimizely-graph-cli@preview webhook:create",
    "sdk:update": "opti-cms schema:vscode",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "compile": "graphql-codegen",
    "watch": "graphql-codegen -w",
    "webhook:create": "npx -y @remkoj/optimizely-graph-cli@preview webhook:create",
    "webhook:list": "npx -y @remkoj/optimizely-graph-cli@preview webhook:list",
    "opti-graph": "npx -y @remkoj/optimizely-graph-cli@preview"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "@remkoj/optimizely-cms-nextjs": "preview",
    "@remkoj/optimizely-cms-react": "preview",
    "@remkoj/optimizely-graph-client": "preview",
    "graphql-request": "^7.4.0",
    "graphql-tag": "^2.12.6",
    "next": "^16.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.2.1",
    "@next/env": "^16.2.1",
    "@parcel/watcher": "^2.5.6",
    "@remkoj/optimizely-cms-cli": "preview",
    "@remkoj/optimizely-graph-functions": "preview",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.1",
    "graphql": "^16.13.2",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "@graphql-codegen/visitor-plugin-common": "file:./packages/graphql-codegen-visitor-plugin-common-v6.2.2-patched.tgz"
  }
}
